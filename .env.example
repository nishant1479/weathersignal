# WeatherSignal Environment Configuration

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL in production, SQLite supported for zero-setup local dev/tests)
DATABASE_URL=sqlite+aiosqlite:///./weathersignal.db

# LLM Configuration
# Modes: "deterministic" (zero-credential rule-based parsing), "openai", "gemini", "anthropic"
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=

# IMD (India Meteorological Department) Configuration
# API Portal: https://api.imd.gov.in/public/index.php
# API Reference: https://api.imd.gov.in/public/api_reference.html
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_TIMEOUT_SECONDS=10.0

# Open-Meteo Auxiliary Observations (Free, no-key fallback for historical & current observations)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_SECONDS=10.0

# Geocoding Provider
# Options: "nominatim" (OpenStreetMap public API, no key required), "mock", "disabled"
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=WeatherSignal/1.0
GEOCODING_TIMEOUT_SECONDS=5.0

# Investigation Limits & Guardrails
MAX_INVESTIGATION_ROUNDS=3
MAX_TOOL_CALLS=10
REQUEST_TIMEOUT_SECONDS=15.0
EVIDENCE_MAX_AGE_MINUTES=1440
MAX_STATION_DISTANCE_KM=50.0
TEMPORAL_WINDOW_HOURS=6.0
